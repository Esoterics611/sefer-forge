*.fixed.txt

# Source photos and recordings stay on this machine: never committed or pushed.
# The transcripts beside them (*.raw.txt, *.timed.txt, *.medium.txt) are kept.
discourses/*/sessions/*/images/
discourses/*/sessions/*/voicenotes/*.m4a
discourses/*/sessions/*/voicenotes/*.mp3
discourses/*/sessions/*/voicenotes/*.wav
discourses/*/sessions/*/voicenotes/*.ogg
discourses/*/sessions/*/voicenotes/*.opus
discourses/*/sessions/*/voicenotes/*.aac
discourses/*/sessions/*/voicenotes/*.flac
discourses/*/sessions/*/voicenotes/*.amr
# transcribe.py's run state
discourses/*/sessions/*/voicenotes/*.partial.txt
discourses/*/sessions/*/voicenotes/*.lock

# Scanned pages of printed editions (page images read for a source): local only,
# like the photos. Their transcriptions are kept as markdown beside the works.
sources/scans/

# A review of an explanation (biur) by the teacher: recordings local only, like a session's
discourses/*/biur/review/*/voicenotes/*.m4a
discourses/*/biur/review/*/voicenotes/*.mp3
discourses/*/biur/review/*/voicenotes/*.wav
