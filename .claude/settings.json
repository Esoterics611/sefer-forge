{
  "permissions": {
    "allow": [
      "Bash(/c/Users/Nexus/AppData/Local/Programs/Python/Python312/python.exe -m pip show torch)",
      "PowerShell(C:\\\\Users\\\\Nexus\\\\AppData\\\\Local\\\\Programs\\\\Python\\\\Python312\\\\python.exe -m pip install torch --index-url https://download.pytorch.org/whl/cpu --force-reinstall 2>&1)",
      "PowerShell(winget install --id Gyan.FFmpeg -e --accept-package-agreements --accept-source-agreements 2>&1)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && for PY in .venv/bin/python .venv/Scripts/python.exe python3 python; do command -v \"$PY\" >/dev/null 2>&1 && break; done; \"$PY\" .claude/hooks/check-session.py",
            "timeout": 30,
            "statusMessage": "Checking the session"
          }
        ]
      }
    ]
  }
}
